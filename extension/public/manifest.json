{
  "manifest_version": 3,
  "name": "Nebula Wallet",
  "version": "1.0.0",
  "description": "Nebula - Quantum-safe Stellar wallet using SPHINCS+ post-quantum signatures",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "https://horizon-testnet.stellar.org/*",
    "https://friendbot.stellar.org/*",
    "https://soroban-testnet.stellar.org/*",
    "https://nebula-ext.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:4022/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}